{
  "color": {
    "$type": "color",
    "tierra": {
      "$description": "Neutros oscuros cálidos (hue 85, base #1F1E1D de bv-personal-finances). La elevación es luz cálida: más alto = más luminoso y apenas más cálido, como acercarse a un foco de 2700K.",
      "0": { "$value": "oklch(0.235 0.008 85)" },
      "1": { "$value": "oklch(0.263 0.009 85)" },
      "2": { "$value": "oklch(0.291 0.01 85)" },
      "3": { "$value": "oklch(0.319 0.011 85)" },
      "4": { "$value": "oklch(0.347 0.012 85)" },
      "5": { "$value": "oklch(0.375 0.013 85)" },
      "6": { "$value": "oklch(0.403 0.014 85)" },
      "7": { "$value": "oklch(0.431 0.015 85)" }
    },
    "arena": {
      "$description": "Neutros claros beige (base #FAF9F5), jamás gris ni blanco frío.",
      "0": { "$value": "oklch(0.982 0.005 95)" },
      "1": { "$value": "oklch(0.9845 0.0045 95)" },
      "2": { "$value": "oklch(0.987 0.004 95)" },
      "3": { "$value": "oklch(0.9895 0.0035 95)" },
      "4": { "$value": "oklch(0.992 0.003 95)" },
      "5": { "$value": "oklch(0.9945 0.0025 95)" },
      "6": { "$value": "oklch(0.997 0.002 95)" },
      "7": { "$value": "oklch(0.999 0.002 95)" }
    },
    "crema": {
      "$description": "Tintas claras cálidas para fondo oscuro.",
      "100": { "$value": "oklch(0.95 0.012 90)" },
      "70": { "$value": "oklch(0.78 0.015 85)" },
      "50": { "$value": "oklch(0.67 0.015 85)" },
      "35": { "$value": "oklch(0.55 0.012 85)" }
    },
    "cacao": {
      "$description": "Tintas oscuras cálidas para fondo claro (base #1A1915).",
      "100": { "$value": "oklch(0.22 0.012 90)" },
      "70": { "$value": "oklch(0.42 0.015 85)" },
      "50": { "$value": "oklch(0.52 0.015 85)" },
      "35": { "$value": "oklch(0.6 0.012 85)" }
    },
    "brasa": {
      "$description": "Acento de marca: coral apagado #C96442 (el de bv-personal-finances). 400 es el coral exacto.",
      "100": { "$value": "oklch(0.8 0.08 40)" },
      "200": { "$value": "oklch(0.71 0.115 39)" },
      "300": { "$value": "oklch(0.66 0.13 39)" },
      "400": { "$value": "oklch(0.617 0.138 39)" },
      "500": { "$value": "oklch(0.56 0.135 38)" },
      "600": { "$value": "oklch(0.52 0.13 38)" },
      "700": { "$value": "oklch(0.46 0.12 37)" }
    },
    "salvia": {
      "$description": "Positivo, verde apagado — confirma sin gritar.",
      "300": { "$value": "oklch(0.74 0.08 150)" },
      "600": { "$value": "oklch(0.52 0.09 150)" }
    },
    "miel": {
      "$description": "Precaución.",
      "300": { "$value": "oklch(0.78 0.09 90)" },
      "600": { "$value": "oklch(0.55 0.1 90)" }
    },
    "teja": {
      "$description": "Peligro/error, terracota apagado.",
      "300": { "$value": "oklch(0.72 0.11 30)" },
      "600": { "$value": "oklch(0.53 0.12 30)" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["medano Sans", "ui-sans-serif", "system-ui", "-apple-system", "sans-serif"]
      },
      "mono": {
        "$value": ["ui-monospace", "Cascadia Code", "SF Mono", "monospace"]
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Escala mobile-first. body = sm en mobile, md en lecturas largas.",
      "2xs": { "$value": "0.75rem" },
      "xs": { "$value": "0.8125rem" },
      "sm": { "$value": "0.9375rem" },
      "md": { "$value": "1.0625rem" },
      "lg": { "$value": "1.25rem" },
      "xl": { "$value": "1.5rem" },
      "2xl": { "$value": "1.875rem" },
      "3xl": { "$value": "2.375rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 650 }
    },
    "leading": {
      "$type": "number",
      "tight": { "$value": 1.25 },
      "base": { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "base": { "$value": "0em" },
      "wide": { "$value": "0.04em" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Base 4px. Generoso: la calma necesita aire.",
    "0": { "$value": "0rem" },
    "3xs": { "$value": "0.125rem" },
    "2xs": { "$value": "0.25rem" },
    "xs": { "$value": "0.5rem" },
    "sm": { "$value": "0.75rem" },
    "md": { "$value": "1rem" },
    "lg": { "$value": "1.5rem" },
    "xl": { "$value": "2rem" },
    "2xl": { "$value": "2.5rem" },
    "3xl": { "$value": "3rem" },
    "4xl": { "$value": "4rem" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Radios generosos, continuidad suave. `quiet` es la esquina quieta: los contenedores de contenido llevan 3 esquinas generosas + 1 casi plana en start-start; los controles de acción quedan simétricos.",
    "quiet": { "$value": "0.25rem" },
    "xs": { "$value": "0.375rem" },
    "sm": { "$value": "0.625rem" },
    "md": { "$value": "0.875rem" },
    "lg": { "$value": "1.25rem" },
    "xl": { "$value": "1.75rem" },
    "full": { "$value": "9999px" }
  },
  "size": {
    "$type": "dimension",
    "tap": {
      "$value": "2.75rem",
      "$description": "Objetivo táctil mínimo: 44px."
    },
    "control-sm": { "$value": "2.25rem" },
    "control-md": { "$value": "2.75rem" },
    "control-lg": { "$value": "3.25rem" },
    "icon-sm": { "$value": "1rem" },
    "icon-md": { "$value": "1.25rem" },
    "icon-lg": { "$value": "1.5rem" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" },
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" },
      "drift": { "$value": "800ms" },
      "breathe": {
        "$value": "4000ms",
        "$description": "Ciclo de respiración de estados idle/espera."
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "snap": {
        "$value": [0.2, 0, 0, 1],
        "$description": "Respuesta directa a input del usuario."
      },
      "glide": {
        "$value": [0.4, 0, 0.2, 1],
        "$description": "Transición espacial estándar."
      },
      "drift": {
        "$value": [0.25, 0.1, 0.15, 1],
        "$description": "Movimiento ambiental, sin urgencia."
      },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  },
  "z": {
    "$type": "number",
    "hide": { "$value": -1 },
    "base": { "$value": 0 },
    "raised": { "$value": 1 },
    "sticky": { "$value": 100 },
    "overlay": { "$value": 900 },
    "modal": { "$value": 1000 },
    "toast": { "$value": 1100 },
    "tooltip": { "$value": 1200 }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "40rem" },
    "md": { "$value": "48rem" },
    "lg": { "$value": "64rem" },
    "xl": { "$value": "80rem" }
  }
}
