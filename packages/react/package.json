{
  "name": "@medano-ui/react",
  "version": "0.1.0",
  "description": "Componentes React de medano — Base UI headless + estilo medano, cero CSS-in-JS runtime",
  "license": "MIT",
  "author": "Braian Vaylet <braianvaylet@gmail.com>",
  "homepage": "https://github.com/BraianVaylet/bv-medano-ui#readme",
  "bugs": "https://github.com/BraianVaylet/bv-medano-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BraianVaylet/bv-medano-ui.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "base-ui",
    "accessible",
    "dark-mode",
    "medano"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && esbuild src/styles.css --bundle --loader:.woff2=file --outfile=dist/styles.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "devDependencies": {
    "@medano-ui/tokens": "workspace:^",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
