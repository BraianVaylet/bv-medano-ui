{
  "name": "@medano-ui/tokens",
  "version": "1.0.3",
  "description": "Design tokens de medano — fuente W3C DTCG compilada a CSS vars, Tailwind v4, TS y React Native",
  "license": "MIT",
  "author": "Braian Vaylet <braianvaylet@gmail.com>",
  "homepage": "https://github.com/BraianVaylet/bv-medano-ui#readme",
  "bugs": "https://github.com/BraianVaylet/bv-medano-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BraianVaylet/bv-medano-ui.git",
    "directory": "packages/tokens"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "dtcg",
    "css-variables",
    "tailwind",
    "oklch",
    "dark-mode",
    "medano"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vars.css": "./dist/vars.css",
    "./theme.css": "./dist/theme.css",
    "./native": "./dist/native/tokens.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "culori": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
